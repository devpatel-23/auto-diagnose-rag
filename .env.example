# ============================================================
# VEHICLE REPAIR CHATBOT - ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. Add .env to .gitignore.

# --- OpenAI ---
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# --- PostgreSQL Database ---
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
# Local development example:
DATABASE_URL=postgresql://postgres:password@localhost:5432/vehicle_repair_bot

# Render.com example (they give you this after creating a Postgres service):
# DATABASE_URL=postgresql://vehicle_repair_bot_user:xxxxx@dpg-xxxxx.oregon-postgres.render.com/vehicle_repair_bot

# --- App Settings ---
# Set to "development" locally, "production" on Render
APP_ENV=development

# Secret key for session management (generate a random string)
SECRET_KEY=your-super-secret-random-key-change-this

# --- Chunking Settings (advanced - leave as default to start) ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Model Settings ---
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
